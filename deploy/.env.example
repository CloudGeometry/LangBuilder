# =============================================================================
# LangBuilder Platform — Unified Environment Configuration
# =============================================================================
# Copy to .env and fill in real values before deploying.
# All passwords default to "changeme-in-production" — rotate before going live.
# =============================================================================

# ─── Shared / Cross-Service ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-change-me
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
LANGWATCH_API_KEY=
LANGWATCH_ENDPOINT=http://langwatch:5560

# ─── LangBuilder ────────────────────────────────────────────────────────────
# Image tags (GHCR)
LB_BACKEND_TAG=latest
LB_FRONTEND_TAG=latest

# Ports (host)
LB_BACKEND_PORT=7860
LB_FRONTEND_PORT=3000

# Database — SQLite by default (no env var needed).
# To switch to Postgres, uncomment and also enable the postgres service in docker-compose.langbuilder.yml:
# LANGBUILDER_DATABASE_URL=postgresql://langbuilder:changeme-in-production@langbuilder-postgres:5432/langbuilder
# LB_POSTGRES_USER=langbuilder
# LB_POSTGRES_PASSWORD=changeme-in-production
# LB_POSTGRES_DB=langbuilder
# LB_POSTGRES_PORT=5433

# Superuser bootstrap (first run only)
LANGBUILDER_SUPERUSER=admin
LANGBUILDER_SUPERUSER_PASSWORD=changeme-in-production

# App config dir inside the container
LANGBUILDER_CONFIG_DIR=app/langbuilder

# ─── OpenWebUI ──────────────────────────────────────────────────────────────
# Image tag (GHCR — our fork)
OPENWEBUI_TAG=latest

# Port (host)
OPENWEBUI_PORT=8080

# Database — SQLite by default; swap the line below for Postgres migration
# SQLite (default):
OPENWEBUI_DATABASE_URL=sqlite:////app/backend/data/webui.db
# Postgres (migration — uncomment and fill in):
# OPENWEBUI_DATABASE_URL=postgresql://openwebui:changeme-in-production@openwebui-postgres:5432/openwebui

# Optional — OpenWebUI auto-generates and persists a key if not set
# WEBUI_SECRET_KEY=

# OAuth / Session (adjust for your domain)
ENABLE_OAUTH_SIGNUP=true
ENABLE_LOGIN_FORM=true
ENABLE_SIGNUP=true
WEBUI_SESSION_COOKIE_SAME_SITE=lax
WEBUI_SESSION_COOKIE_SECURE=false

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Telemetry opt-out
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# ─── LangWatch ──────────────────────────────────────────────────────────────
# Port (host) — only the main app is exposed; internal services use the Docker network
LW_APP_PORT=5560

# Postgres
LW_POSTGRES_USER=langwatch
LW_POSTGRES_PASSWORD=changeme-in-production
LW_POSTGRES_DB=langwatch

# Auth (NextAuth — generate with: openssl rand -base64 32)
LW_NEXTAUTH_SECRET=changeme-in-production
LW_NEXTAUTH_URL=http://localhost:5560
LW_BASE_HOST=http://localhost:5560

# OpenSearch
LW_OPENSEARCH_JAVA_OPTS="-Xms256m -Xmx512m"
